# Local-development defaults for the Trustvian reference deployment.
#
#   cp .env.example .env
#
# THESE ARE NOT PRODUCTION CREDENTIALS. They are obvious placeholders for a
# throwaway database that lives in a Docker volume on your own machine, and
# they are checked into the repository on purpose so the quickstart works
# with no setup. A real deployment supplies its credentials through a
# secret manager and uses PostgreSQL TLS — see README.md § Security.
#
# Compose reads .env automatically. Every value below also has an inline
# default in compose.yaml, so the stack runs even without this file.

# --- PostgreSQL -------------------------------------------------------
TRUSTVIAN_POSTGRES_USER=trustvian
TRUSTVIAN_POSTGRES_PASSWORD=change-me
TRUSTVIAN_POSTGRES_DB=trustvian

# Host port for psql inspection and for reusing this database with the
# repository's PostgreSQL integration tests. Bound to 127.0.0.1 only.
TRUSTVIAN_POSTGRES_HOST_PORT=5433

# --- Collector --------------------------------------------------------
TRUSTVIAN_OTLP_GRPC_PORT=4317

# --- Demo producer ----------------------------------------------------
# The actor Trustvian learns about (resource service.name).
TRUSTVIAN_DEMO_ACTOR=demo-payments
TRUSTVIAN_DEMO_ENVIRONMENT=production
TRUSTVIAN_DEMO_SPAN_COUNT=60

# Set to true to append one deliberately abnormal span — a slow call to an
# unfamiliar target — so a trained baseline visibly reacts to it.
TRUSTVIAN_DEMO_ANOMALY=false
